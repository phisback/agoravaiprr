{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": [
    "ffmpeg",
    "fonts-dejavu-core",
    "fonts-noto",
    "fonts-liberation",
    "fontconfig",
    "espeak-ng",
    "python3",
    "python3-venv",
    "git",
    "libstdc++6",
    "libgomp1"
  ],
  "steps": {
    "build": {
      "commands": [
        "...",
        "python3 -m venv .venv",
        "PIP_USER=0 .venv/bin/python -m pip install --no-cache-dir --no-user -r requirements.txt",
        "mkdir -p data/tts/chatterbox-cache",
        "npx prisma generate",
        "mkdir -p /var/fonts",
        "find /usr/share/fonts -name '*.ttf' -exec cp {} /var/fonts/ \\; 2>/dev/null || true",
        "find /usr/local/share/fonts -name '*.ttf' -exec cp {} /var/fonts/ \\; 2>/dev/null || true",
        "fc-cache -f -v 2>&1 | tail -3 || true",
        "fc-list | head -10 || true"
      ]
    }
  },
  "deploy": {
    "inputs": ["..."],
    "aptPackages": [
      "ffmpeg",
      "fonts-dejavu-core",
      "fonts-noto",
      "fonts-liberation",
      "fontconfig",
      "espeak-ng",
      "python3",
      "git",
      "libstdc++6",
      "libgomp1"
    ],
    "startCommand": "npx prisma generate && node scripts/restore-guild-economy.js && node scripts/reconcile-gold-economy.js && node src/index.js"
  }
}

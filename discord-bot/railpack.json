{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": [
    "ffmpeg",
    "fonts-dejavu-core",
    "fonts-noto",
    "fonts-liberation",
    "fontconfig",
    "espeak-ng",
    "python3",
    "python3-venv",
    "libstdc++6",
    "libgomp1"
  ],
  "steps": {
    "build": {
      "commands": [
        "...",
        "python3 -m venv .venv",
        "PIP_USER=0 .venv/bin/python -m pip install --no-cache-dir --no-user -r requirements.txt",
        "mkdir -p data/tts/kokoro",
        "curl -fL --retry 3 --retry-delay 2 -o data/tts/kokoro/kokoro-v1.0.onnx https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/kokoro-v1.0.onnx",
        "curl -fL --retry 3 --retry-delay 2 -o data/tts/kokoro/voices-v1.0.bin https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/voices-v1.0.bin",
        ".venv/bin/python scripts/kokoro_tts_worker.py --warmup",
        "test -s data/tts/kokoro/kokoro-v1.0.onnx",
        "test -s data/tts/kokoro/voices-v1.0.bin",
        "rm -f /tmp/kokoro-warmup.wav",
        "npx prisma generate",
        "mkdir -p /var/fonts",
        "find /usr/share/fonts -name '*.ttf' -exec cp {} /var/fonts/ \\; 2>/dev/null || true",
        "find /usr/local/share/fonts -name '*.ttf' -exec cp {} /var/fonts/ \\; 2>/dev/null || true",
        "fc-cache -f -v 2>&1 | tail -3 || true",
        "fc-list | head -10 || true"
      ]
    }
  },
  "deploy": {
    "inputs": ["..."],
    "aptPackages": [
      "ffmpeg",
      "fonts-dejavu-core",
      "fonts-noto",
      "fonts-liberation",
      "fontconfig",
      "espeak-ng",
      "python3",
      "libstdc++6",
      "libgomp1"
    ],
    "startCommand": "npx prisma generate && node scripts/restore-guild-economy.js && node src/index.js"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Interaction {
  id      String  @id @default(cuid())
  type    String
  fromId  String
  toId    String
  guildId String?
  count   Int     @default(1)

  @@unique([type, fromId, toId])
}

model ReputationGive {
  id          String   @id @default(cuid())
  guildId     String
  giverId     String
  receiverId  String
  lastGivenAt DateTime @default(now())

  @@unique([guildId, giverId, receiverId])
  @@index([guildId, receiverId])
}

model TellonymProfile {
  id     String @id @default(cuid())
  userId String @unique
  link   String
}

model TicketOption {
  id          String   @id @default(cuid())
  guildId     String
  label       String
  emoji       String   @default("🎫")
  description String   @default("")
  pingRole    String   @default("")
  pingUser    String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model Ticket {
  id        String   @id @default(cuid())
  channelId String   @unique
  userId    String
  guildId   String
  reason    String?
  answer1   String?
  answer2   String?
  answer3   String?
  claimedBy String?
  status    String   @default("open")
  createdAt DateTime @default(now())
}

model StaffRating {
  id         String   @id @default(cuid())
  guildId    String
  ticketId   String
  reviewerId String
  staffId    String
  stars      Int
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([ticketId, reviewerId])
  @@index([guildId, staffId])
  @@index([ticketId])
}

model CommandBlockRule {
  id           String   @id @default(cuid())
  guildId      String
  commandName  String
  scopeType    String
  scopeId      String
  isException  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([guildId, commandName, scopeType, scopeId, isException])
  @@index([guildId, commandName])
}

model ChatLock {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  allowedRoleIds String   @default("")
  lockedById     String
  lockedAt       DateTime @default(now())

  @@unique([guildId, channelId])
  @@index([guildId])
}

model MemberWarning {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, userId])
}

model GuildConfig {
  id      String @id @default(cuid())
  guildId String @unique

  ticketChannel        String?
  ticketCategory       String?
  ticketColor          String?
  ticketBanner         String?
  ticketThumb          String?
  ticketFooter         String?
  ticketTitle          String?
  ticketText           String?
  ticketPingRole       String?
  ticketPingUser       String?
  ticketBtnLabel       String?
  ticketBtnEmoji       String?
  ticketBtnStyle       String?
  ticketOpenText       String?
  ticketUseSeparator   Boolean @default(false)
  ticketBannerPosition String  @default("top")
  ticketOnlyBanner     Boolean @default(false)
  ticketUseMenu        Boolean @default(false)
  ticketQuestion1      String?
  ticketQuestion2      String?
  ticketQuestion3      String?
  ticketAiEnabled      Boolean @default(false)

  instaChannel String?
  instaColor   String?
  instaEmoji   String  @default("💜")
  instaHandle  String?

  bumpEnabled  Boolean  @default(false)
  bumpChannel  String?
  bumpRole     String?
  bumpNextAt   DateTime?

  tellonymChannel  String?
  tellonymColor    String?
  tellonymBanner   String?
  tellonymThumb    String?
  tellonymFooter   String?
  tellonymTitle    String?
  tellonymText     String?
  tellonymBtnLabel String?
  tellonymBtnEmoji String?

  lojaTitle          String?
  lojaText           String?
  lojaBanner         String?
  lojaBannerPos      String? @default("top")
  lojaThumb          String?
  lojaColor          String?
  lojaConversao      String?
  lojaUseDivider     Boolean @default(false)
  shopEmojiComprar   String?
  shopEmojiVitrine   String?
  shopEmojiConverter String?
  shopEmojiSaldo     String?
  shopEmojiGift      String?
  shopBtnStyles      String?

  vipTitle            String?
  vipIntro            String?
  vipText             String?
  vipBanner           String?
  vipThumb            String?
  vipColor            String?
  vipPriceLabel       String?
  vipBtnEscolherLabel String?
  vipBtnCarrinhoLabel String?
  vipEmojiCoin        String?
  vipEmojiTag         String?
  vipEmojiBtn1        String?
  vipEmojiBtn2        String?
  vipPlans            VipPlan[]

  welcomeEnabled        Boolean @default(true)
  welcomeChannel        String?
  welcomeColor          String?
  welcomeBanner         String?
  welcomeThumb          String?
  welcomeFooter         String?
  welcomeTitle          String?
  welcomeText           String?
  welcomeRoles          String?
  welcomeChannels       String?
  welcomeUseDivider     Boolean @default(false)
  welcomeBannerPosition String  @default("top")
  welcomeShowTitle      Boolean @default(true)
  welcomeShowAvatar     Boolean @default(true)
  welcomeDeleteAfter    Int?

  partnerEnabled         Boolean @default(false)
  partnerChannel         String?
  partnerResponsibleRole String?
  partnerPingRole        String?
  partnerRole            String?
  partnerNotifyDm        Boolean @default(false)
  partnerMessage         String?
  partnerDescription     String?
  partnerImage           String?
  partnerThumbnail       String?
  partnerFooter          String?
  partnerJoinButtonText  String?
  partnerJoinButtonEmoji String?
  partnerMessageButtonText  String?
  partnerMessageButtonEmoji String?
  partnerColor           String?
  partnerRemoveOnLeave   Boolean @default(false)
  partnerMinMembers      Int?

  botIconUrl   String?
  botBannerUrl String?
  botBio       String?

  presencedEnabled        Boolean @default(false)
  presencedConsoles       String  @default("PS3,WiiU")
  presencedPollInterval   Int     @default(10)
  presencedPs3Address     String?
  presencedPs3Network     String  @default("PSN")
  presencedPs3NetworkFull String  @default("PlayStation Network")
  presencedPs3NetworkId   String  @default("{anon-user}")
  presencedPs3UseCelsius  Boolean @default(true)
  presencedWiiuPort       Int     @default(5005)
  presencedWiiuFirmware   String  @default("{unknown-ver}")
  presencedWiiuHardware   String  @default("IBM Espresso | AMD Latte")

  aiChannelId      String?
  dropAllowedRoles String?
  boostRoles       String?

  antiLinkEnabled         Boolean @default(false)
  antiLinkAction          String  @default("delete_warn")
  antiLinkBlockDiscord    Boolean @default(true)
  antiLinkBlockSocial     Boolean @default(true)
  antiLinkBlockShorteners Boolean @default(true)
  antiLinkBlockAll        Boolean @default(true)
  antiLinkAllowedDomains  String?
  antiLinkAllowedChannels String?
  antiLinkAllowedRoles    String?
  antiLinkLogChannel      String?
}

model VipPlan {
  id       String      @id @default(cuid())
  guildId  String
  name     String
  price    String
  emoji    String?
  roleId   String?
  position Int         @default(0)
  config   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model MessageTrigger {
  id             String   @id @default(cuid())
  guildId        String
  name           String   @default("")
  keywords       String
  responseUrl    String
  responseName   String
  responseType   String?
  responseSize   Int?
  storageKey     String?
  responseData   Bytes?
  createdAt      DateTime @default(now())

  @@index([guildId])
}

model Partnership {
  id               String   @id @default(cuid())
  guildId          String
  partnerServerId  String
  partnerName      String
  promoterId       String
  representativeId String?
  inviteCode       String
  messageUrl       String?
  createdAt        DateTime @default(now())
}

model Economy {
  id           String    @id @default(cuid())
  userId       String
  guildId      String
  balance      Int       @default(0)
  bank         Int       @default(0)
  messageCount Int       @default(0)
  callMinutes  Int       @default(0)
  xp           Int       @default(0)
  level        Int       @default(1)
  lastDaily    DateTime?
  lastWeekly   DateTime?
  lastMonthly  DateTime?
  lastWork     DateTime?
  lastRob      DateTime?
  dailyStreak  Int       @default(0)
  workLevel    Int       @default(1)
  workXp       Int       @default(0)
  lastPetPlay  DateTime?
  lastPetFeed  DateTime?
  lastPetPet   DateTime?

  @@unique([userId, guildId])
}

model BankAccount {
  id              String        @id @default(cuid())
  userId          String
  guildId         String
  passwordHash    String
  midasBalance    Decimal       @default(0) @db.Decimal(20, 8)
  failedAttempts  Int           @default(0)
  lockedUntil     DateTime?
  lastAccessAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  holdings        BankHolding[]

  @@unique([userId, guildId])
  @@index([guildId, userId])
}

model BankHolding {
  id            String      @id @default(cuid())
  accountId     String
  userId        String
  guildId       String
  symbol        String
  quantity      Int         @default(0)
  averagePrice  Decimal     @db.Decimal(20, 8)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  account       BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
  @@index([guildId, userId])
}

model Business {
  id              String   @id @default(cuid())
  userId          String
  guildId         String
  businessKey     String
  level           Int      @default(1)
  lastCollectedAt DateTime @default(now())
  totalEarned     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, guildId, businessKey])
  @@index([guildId, userId])
}

model CriminalRecord {
  id        String    @id @default(cuid())
  userId    String
  guildId   String
  debt      Int       @default(0)
  arrests   Int       @default(0)
  crimes    Int       @default(0)
  lastCrime DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, guildId])
  @@index([guildId, userId])
}

model FishingProfile {
  id                       String    @id @default(cuid())
  userId                   String
  guildId                  String
  rodKey                   String    @default("bambu")
  activeBaitKey            String?
  selectedSpotKey          String    @default("lago")
  lastFishing              DateTime?
  totalCaught              Int       @default(0)
  sealBlessing             Boolean   @default(false)
  sharkBattleHp            Int       @default(0)
  sharkBattleReward        Int       @default(0)
  legendaryBattleUserId    String?
  legendaryBattleRound     Int       @default(0)
  legendaryBattleChoice    String?
  legendaryBattleExpiresAt DateTime?
  dailyMissionDate         String?
  dailyMissionKey          String?
  dailyMissionProgress     Int       @default(0)
  dailyMissionClaimed      Boolean   @default(false)

  @@unique([userId, guildId])
}

model FishingCatch {
  id           String @id @default(cuid())
  userId       String
  guildId      String
  fishKey      String
  quantity     Int    @default(0)
  qualityTotal Int    @default(0)

  @@unique([userId, guildId, fishKey])
  @@index([userId, guildId])
}

model FishingItem {
  id       String @id @default(cuid())
  userId   String
  guildId  String
  itemKey  String
  quantity Int    @default(0)

  @@unique([userId, guildId, itemKey])
  @@index([userId, guildId])
}

model PanelPreset {
  id        String   @id @default(cuid())
  guildId   String
  type      String
  name      String
  color     String?
  banner    String?
  thumb     String?
  footer    String?
  title     String?
  text      String?
  createdAt DateTime @default(now())

  @@unique([guildId, type, name])
}

model ShopRole {
  id          String   @id @default(cuid())
  guildId     String
  roleId      String
  name        String
  description String?
  price       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([guildId, roleId])
}

model UserPurchase {
  id          String   @id @default(cuid())
  userId      String
  guildId     String?
  itemType    String
  itemRef     String
  purchasedAt DateTime @default(now())

  @@unique([userId, itemType, itemRef])
}

model CardCollection {
  id              String   @id @default(cuid())
  userId          String
  cardKey         String
  quantity        Int      @default(1)
  firstObtainedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, cardKey])
  @@index([userId])
}

model CardBattleTeam {
  id        String   @id @default(cuid())
  userId    String
  guildId   String
  cardKeys  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, guildId])
  @@index([guildId])
}

model UserProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  guildId          String?
  activeBanner     String?
  activeRing       String?
  ringBorderColor  String?
  activePet        String?
  bio              String?
  marriedTo        String?
  marriedToName    String?
  marriedAt        DateTime?
  bestFriendId     String?
  bestFriendName   String?
  reps             Int       @default(0)
  cardBg1          String?
  cardBg2          String?
  cardPanelColor   String?
  walletBg         String?
  walletRing       String?
  walletRingBorder String?
  walletFrame      String?
}

model UserAfk {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId])
}

model Pet {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  emoji       String
  imageUrl    String?
  description String?
  price       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([guildId, name])
}

model Badge {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  emoji       String
  description String
  color       String @default("9B4FD6")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeKey])
}

model GuildBadgeEmoji {
  id       String @id @default(cuid())
  guildId  String
  badgeKey String
  emoji    String

  @@unique([guildId, badgeKey])
}

model CustomBanner {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String   @default("")
  price       Int      @default(1000)
  imageUrl    String
  gradient1   String   @default("#1a0533")
  gradient2   String   @default("#4a1a8a")
  emoji       String   @default("🖼️")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([guildId, key])
}

model PublishedMsgData {
  messageId String   @id
  guildId   String
  data      String
  createdAt DateTime @default(now())
}

model CopaConfig {
  id                    Int      @id @default(1)
  guildId               String   @default("")
  announcementChannelId String   @default("")
  enabled               Boolean  @default(false)
  emojiHomeWin          String   @default("🏠")
  emojiDraw             String   @default("🤝")
  emojiAwayWin          String   @default("✈️")
  pointsWin             Int      @default(3)
  pointsDraw            Int      @default(1)
  pointsExact           Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CopaMatch {
  id        Int      @id @default(autoincrement())
  teamA     String
  teamB     String
  teamAFlag String   @default("")
  teamBFlag String   @default("")
  matchDate DateTime
  phase     String   @default("Fase de Grupos")
  group     String   @default("")
  stadium   String   @default("")
  bannerUrl String   @default("")
  channelId String   @default("")
  messageId String   @default("")
  status    String   @default("pending")
  scoreA    Int?
  scoreB    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions CopaPrediction[]
}

model CopaPrediction {
  id              Int      @id @default(autoincrement())
  matchId         Int
  discordUserId   String
  discordUsername String   @default("")
  prediction      String
  points          Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  match CopaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, discordUserId])
}

model VipGrant {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([guildId, userId, roleId])
  @@index([expiresAt])
}

model VipCustomRole {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([roleId])
}

model VipRoleGrantRequest {
  id          String   @id @default(cuid())
  guildId     String
  roleId      String
  giverId     String
  recipientId String
  status      String   @default("PENDING")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([recipientId, status])
  @@index([guildId, giverId, status])
  @@index([expiresAt])
}

/// Token do usuário para automação de Discord Quests (/quest)
model UserQuestToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String
  updatedAt DateTime @updatedAt
}
